# Used by docker-compose.yml. Copy to .env and fill in real values before running
# `docker compose up` — see docs/DEPLOYMENT_BHARAT_CLOUD.md for how this maps to
# staging vs production on the VM (GitHub Actions writes this file automatically there).
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_PORT=8030
BACKEND_PORT=8035
# Loopback-only port for reaching Postgres via an SSH tunnel (pgAdmin, psql) — never
# exposed to the internet. Staging and production need different values on the same
# VM: 15432 for staging, 15433 for production.
DB_TUNNEL_PORT=15432
# Which branch deploy.sh pulls from — "staging" here, "main" for production. Read
# explicitly rather than inferred from the current checkout (see deploy.sh's comment).
DEPLOY_BRANCH=staging
