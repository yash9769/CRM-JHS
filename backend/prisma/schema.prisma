// ============================================================================
// Sales CRM — Prisma schema
//
// Naming note: the PRD uses "Account" for two different concepts — (1) the
// tenant/organization using the CRM, and (2) a CRM "Account" record (a
// customer company). To avoid collision we use `tenantId` for multi-tenant
// isolation (PRD section 19) and keep `accountId` strictly as the foreign key
// to the CRM Account entity (PRD section 3).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Users
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users             User[]
  accounts          Account[]
  contacts          Contact[]
  opportunities     Opportunity[]
  deals             Deal[]
  quotes            Quote[]
  products          Product[]
  activities        Activity[]
  notes             Note[]
  sequences         Sequence[]
  pipelines         Pipeline[]
  associations      Association[]
  propertyDefs      PropertyDefinition[]
  forecastTargets   ForecastTarget[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@map("tenants")
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_REP
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(SALES_REP)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedAccounts       Account[]      @relation("AccountOwner")
  ownedContacts       Contact[]      @relation("ContactOwner")
  ownedOpportunities  Opportunity[]  @relation("OpportunityOwner")
  ownedDeals          Deal[]         @relation("DealOwner")
  ownedQuotes         Quote[]        @relation("QuoteOwner")
  ownedProducts       Product[]      @relation("ProductOwner")
  activities          Activity[]     @relation("ActivityOwner")
  notes               Note[]         @relation("NoteAuthor")
  sequences           Sequence[]     @relation("SequenceOwner")
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@unique([tenantId, email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Accounts (companies) & Contacts
// ---------------------------------------------------------------------------

enum AccountType {
  PROSPECT
  CUSTOMER
  PARTNER
  FORMER_CUSTOMER
}

model Account {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  name          String
  domain        String?
  industry      String?
  employeeCount Int?
  annualRevenue Decimal?    @db.Decimal(16, 2)
  ownerId       String?
  owner         User?       @relation("AccountOwner", fields: [ownerId], references: [id])
  accountType   AccountType @default(PROSPECT)
  billingAddress String?
  phone         String?
  website       String?
  description   String?
  properties    Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  deals         Deal[]
  quotes        Quote[]
  activities    Activity[]
  notes         Note[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, domain])
  @@map("accounts")
}

enum LifecycleStage {
  SUBSCRIBER
  LEAD
  MARKETING_QUALIFIED
  SALES_QUALIFIED
  OPPORTUNITY
  CUSTOMER
  EVANGELIST
}

model Contact {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  accountId      String?
  account        Account?        @relation(fields: [accountId], references: [id])
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  lifecycleStage LifecycleStage  @default(LEAD)
  leadSource     String?
  ownerId        String?
  owner          User?           @relation("ContactOwner", fields: [ownerId], references: [id])
  linkedinUrl    String?
  address        String?
  properties     Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  opportunityContacts OpportunityContact[]
  dealContacts        DealContact[]
  activities          Activity[]
  notes               Note[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, accountId])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Pipelines & Stages (shared by Opportunities and Deals)
// ---------------------------------------------------------------------------

enum PipelineType {
  OPPORTUNITY
  DEAL
}

model Pipeline {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  name      String
  type      PipelineType
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())

  stages        PipelineStage[]
  opportunities Opportunity[]
  deals         Deal[]

  @@index([tenantId, type])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])
  name        String
  order       Int
  probability Int      @default(0) // default probability % for this stage
  isClosed    Boolean  @default(false)
  isWon       Boolean  @default(false)

  opportunities Opportunity[]
  deals         Deal[]

  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ---------------------------------------------------------------------------
// Opportunities
// ---------------------------------------------------------------------------

enum OpportunityType {
  NEW_BUSINESS
  EXPANSION
  RENEWAL
}

model Opportunity {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  name              String
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  amount            Decimal         @db.Decimal(16, 2)
  pipelineId        String
  pipeline          Pipeline        @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             PipelineStage   @relation(fields: [stageId], references: [id])
  probability       Int             @default(0)
  expectedCloseDate DateTime?
  ownerId           String
  owner             User            @relation("OpportunityOwner", fields: [ownerId], references: [id])
  opportunityType   OpportunityType @default(NEW_BUSINESS)
  leadSource        String?
  description       String?
  properties        Json            @default("{}")
  convertedDealId   String?         @unique
  convertedDeal     Deal?           @relation("OpportunityToDeal", fields: [convertedDealId], references: [id])
  isConverted       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  contacts     OpportunityContact[]
  stageHistory OpportunityStageHistory[]
  activities   Activity[]
  notes        Note[]
  dealsFrom    Deal[]                    @relation("DealFromOpportunity")

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([tenantId, stageId])
  @@index([tenantId, ownerId])
  @@map("opportunities")
}

model OpportunityContact {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])
  role          String?

  @@id([opportunityId, contactId])
  @@map("opportunity_contacts")
}

model OpportunityStageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  fromStageId   String?
  toStageId     String
  changedById   String
  changedAt     DateTime    @default(now())

  @@index([opportunityId])
  @@map("opportunity_stage_history")
}

// ---------------------------------------------------------------------------
// Deals
// ---------------------------------------------------------------------------

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED_WON
  CLOSED_LOST
}

model Deal {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  name              String
  accountId         String
  account           Account           @relation(fields: [accountId], references: [id])
  opportunityId     String?           @unique
  opportunity       Opportunity?      @relation("DealFromOpportunity", fields: [opportunityId], references: [id])
  originatingOpportunity Opportunity? @relation("OpportunityToDeal")
  amount            Decimal           @db.Decimal(16, 2)
  pipelineId        String
  pipeline          Pipeline          @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             PipelineStage     @relation(fields: [stageId], references: [id])
  closeDate         DateTime?
  ownerId           String
  owner             User              @relation("DealOwner", fields: [ownerId], references: [id])
  probability       Int               @default(0)
  dealType          String?
  forecastCategory  ForecastCategory  @default(PIPELINE)
  description       String?
  properties        Json              @default("{}")
  wonDate           DateTime?
  lostReason        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  contacts     DealContact[]
  stageHistory DealStageHistory[]
  activities   Activity[]
  notes        Note[]
  lineItems    LineItem[]
  quotes       Quote[]

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([tenantId, stageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, closeDate])
  @@map("deals")
}

model DealContact {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id])
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
  role      String?

  @@id([dealId, contactId])
  @@map("deal_contacts")
}

model DealStageHistory {
  id          String   @id @default(uuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id])
  fromStageId String?
  toStageId   String
  changedById String
  changedAt   DateTime @default(now())

  @@index([dealId])
  @@map("deal_stage_history")
}

// ---------------------------------------------------------------------------
// Products & Line Items
// ---------------------------------------------------------------------------

model Product {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  sku        String?
  category   String?
  description String?
  unitPrice  Decimal  @db.Decimal(16, 2)
  currency   String   @default("USD")
  active     Boolean  @default(true)
  ownerId    String?
  owner      User?    @relation("ProductOwner", fields: [ownerId], references: [id])
  properties Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lineItems LineItem[]

  @@index([tenantId])
  @@index([tenantId, sku])
  @@map("products")
}

model LineItem {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id])
  quoteId    String?
  quote      Quote?   @relation(fields: [quoteId], references: [id])
  quantity   Decimal  @db.Decimal(12, 2)
  unitPrice  Decimal  @db.Decimal(16, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  taxPct      Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(16, 2)
  createdAt   DateTime @default(now())

  @@index([dealId])
  @@index([quoteId])
  @@map("line_items")
}

// ---------------------------------------------------------------------------
// Quotes
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  quoteNumber    String
  dealId         String
  deal           Deal        @relation(fields: [dealId], references: [id])
  accountId      String
  account        Account     @relation(fields: [accountId], references: [id])
  quoteDate      DateTime    @default(now())
  expirationDate DateTime?
  discountPct    Decimal     @default(0) @db.Decimal(5, 2)
  taxPct         Decimal     @default(0) @db.Decimal(5, 2)
  amount         Decimal     @db.Decimal(16, 2)
  currency       String      @default("USD")
  status         QuoteStatus @default(DRAFT)
  ownerId        String
  owner          User        @relation("QuoteOwner", fields: [ownerId], references: [id])
  pdfUrl         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lineItems LineItem[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([tenantId, dealId])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Activities & Notes (shared timeline)
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  FOLLOW_UP
  DEMO
  PROPOSAL
  OTHER
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AssociatedObjectType {
  ACCOUNT
  CONTACT
  OPPORTUNITY
  DEAL
  QUOTE
}

model Activity {
  id             String               @id @default(uuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  type           ActivityType
  subject        String
  body           String?
  ownerId        String
  owner          User                 @relation("ActivityOwner", fields: [ownerId], references: [id])
  dueDate        DateTime?
  completedDate  DateTime?
  status         ActivityStatus       @default(PENDING)
  objectType     AssociatedObjectType
  accountId      String?
  account        Account?             @relation(fields: [accountId], references: [id])
  contactId      String?
  contact        Contact?             @relation(fields: [contactId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?         @relation(fields: [opportunityId], references: [id])
  dealId         String?
  deal           Deal?                @relation(fields: [dealId], references: [id])
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([tenantId, contactId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, dealId])
  @@map("activities")
}

model Note {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  body          String
  authorId      String
  author        User     @relation("NoteAuthor", fields: [authorId], references: [id])
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Sequences (Phase 4 — schema only for now)
// ---------------------------------------------------------------------------

enum SequenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DRAFT
}

model Sequence {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  ownerId     String
  owner       User           @relation("SequenceOwner", fields: [ownerId], references: [id])
  status      SequenceStatus @default(DRAFT)
  createdAt   DateTime       @default(now())

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@map("sequences")
}

enum SequenceStepType {
  EMAIL
  WAIT
  TASK
  CALL_REMINDER
}

model SequenceStep {
  id         String           @id @default(uuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id])
  order      Int
  type       SequenceStepType
  config     Json             @default("{}")

  @@index([sequenceId])
  @@map("sequence_steps")
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLIED
  UNENROLLED
}

model SequenceEnrollment {
  id             String           @id @default(uuid())
  sequenceId     String
  sequence       Sequence         @relation(fields: [sequenceId], references: [id])
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id])
  status         EnrollmentStatus @default(ACTIVE)
  currentStepIdx Int              @default(0)
  enrolledAt     DateTime         @default(now())
  lastActionAt   DateTime?
  nextActionAt   DateTime?

  @@index([sequenceId])
  @@index([contactId])
  @@map("sequence_enrollments")
}

// ---------------------------------------------------------------------------
// Associations (generic relationship model, PRD section 18)
// ---------------------------------------------------------------------------

model Association {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  fromObjectType   String
  fromRecordId     String
  toObjectType     String
  toRecordId       String
  associationLabel String?
  createdAt        DateTime @default(now())

  @@index([tenantId, fromObjectType, fromRecordId])
  @@index([tenantId, toObjectType, toRecordId])
  @@map("associations")
}

// ---------------------------------------------------------------------------
// Custom Properties
// ---------------------------------------------------------------------------

enum PropertyType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  CURRENCY
  DROPDOWN
  MULTI_SELECT
  URL
  EMAIL
}

model PropertyDefinition {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  objectType  String
  name        String
  label       String
  type        PropertyType
  required    Boolean      @default(false)
  defaultValue String?
  enumOptions Json?
  createdAt   DateTime     @default(now())

  @@unique([tenantId, objectType, name])
  @@map("property_definitions")
}

// ---------------------------------------------------------------------------
// Forecasting
// ---------------------------------------------------------------------------

model ForecastTarget {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  ownerId   String?
  period    String   // e.g. "2026-08"
  targetAmount Decimal @db.Decimal(16, 2)
  createdAt DateTime @default(now())

  @@unique([tenantId, ownerId, period])
  @@map("forecast_targets")
}

// ---------------------------------------------------------------------------
// Audit Log & Notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  objectType String
  recordId   String
  action     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, objectType, recordId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, userId, read])
  @@map("notifications")
}
