// ============================================================================
// Sales CRM — Prisma schema (v2 — RBAC: Senior Partner / Partner / Manager)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Users
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users           User[]
  accounts        Account[]
  contacts        Contact[]
  opportunities   Opportunity[]
  quotes          Quote[]
  services        Service[]
  products        Product[]
  activities      Activity[]
  notes           Note[]
  sequences       Sequence[]
  pipelines       Pipeline[]
  associations    Association[]
  propertyDefs    PropertyDefinition[]
  forecastTargets ForecastTarget[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  leads           Lead[]
  savedViews      SavedView[]
  stageApprovals  StageApproval[]
  stickyNotes     StickyNote[]
  opportunityAttachments OpportunityAttachment[]

  @@map("tenants")
}

enum OrgRole {
  SENIOR_PARTNER
  PARTNER
  MANAGER
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  orgRole      OrgRole  @default(MANAGER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Hierarchy links
  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  partnerId String?
  partner   User?   @relation("ManagerPartner", fields: [partnerId], references: [id])
  managers  User[]  @relation("ManagerPartner")

  // CRM record ownership
  ownedAccounts      Account[]      @relation("AccountOwner")
  ownedContacts      Contact[]      @relation("ContactOwner")
  ownedOpportunities Opportunity[]  @relation("OpportunityOwner")
  ownedQuotes        Quote[]        @relation("QuoteOwner")
  ownedProducts      Product[]      @relation("ProductOwner")
  activities         Activity[]     @relation("ActivityOwner")
  notes              Note[]         @relation("NoteAuthor")
  sequences          Sequence[]     @relation("SequenceOwner")
  auditLogs          AuditLog[]
  notifications      Notification[]
  ownedLeads         Lead[]         @relation("LeadOwner")
  savedViews         SavedView[]

  // RBAC: records created BY this user
  createdAccounts      Account[]      @relation("AccountCreator")
  createdContacts      Contact[]      @relation("ContactCreator")
  createdOpportunities Opportunity[]  @relation("OpportunityCreator")
  createdLeads         Lead[]         @relation("LeadCreator")
  createdProducts      Product[]      @relation("ProductCreator")
  createdQuotes        Quote[]        @relation("QuoteCreator")
  createdSequences     Sequence[]     @relation("SequenceCreator")
  createdActivities    Activity[]     @relation("ActivityCreator")

  requestedApprovals StageApproval[] @relation("ApprovalRequestedBy")
  receivedApprovals  StageApproval[] @relation("ApprovalApprover")
  reviewedApprovals  StageApproval[] @relation("ApprovalReviewedBy")
  stickyNotes        StickyNote[]    @relation("UserStickyNotes")
  uploadedOpportunityAttachments OpportunityAttachment[] @relation("AttachmentUploader")

  @@unique([tenantId, email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Accounts (companies) & Contacts
// ---------------------------------------------------------------------------

enum AccountType {
  PROSPECT
  CUSTOMER
  PARTNER
  FORMER_CUSTOMER
}

model Account {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  name           String
  domain         String?
  industry       String?
  employeeCount  Int?
  annualRevenue  Decimal?    @db.Decimal(16, 2)
  ownerId        String?
  owner          User?       @relation("AccountOwner", fields: [ownerId], references: [id])
  createdById    String?
  createdBy      User?       @relation("AccountCreator", fields: [createdById], references: [id])
  accountType    AccountType @default(PROSPECT)
  billingAddress String?
  phone          String?
  website        String?
  description    String?
  properties     Json        @default("{}")
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  quotes        Quote[]
  activities    Activity[]
  notes         Note[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, domain])
  @@index([tenantId, createdById])
  @@map("accounts")
}

enum LifecycleStage {
  SUBSCRIBER
  LEAD
  MARKETING_QUALIFIED
  SALES_QUALIFIED
  OPPORTUNITY
  CUSTOMER
  EVANGELIST
}

model Contact {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  accountId      String?
  account        Account?       @relation(fields: [accountId], references: [id])
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  lifecycleStage LifecycleStage @default(LEAD)
  leadSource     String?
  ownerId        String?
  owner          User?          @relation("ContactOwner", fields: [ownerId], references: [id])
  createdById    String?
  createdBy      User?          @relation("ContactCreator", fields: [createdById], references: [id])
  linkedinUrl    String?
  address        String?
  properties     Json           @default("{}")
  archived       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  opportunityContacts  OpportunityContact[]
  primaryOpportunities Opportunity[]        @relation("OpportunityPrimaryContact")
  activities           Activity[]
  notes                Note[]
  sequenceEnrollments  SequenceEnrollment[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, accountId])
  @@index([tenantId, createdById])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Leads (unqualified, pre-Account/Contact prospects)
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NURTURING
  UNQUALIFIED
  CONVERTED
}

model Lead {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  firstName   String
  lastName    String
  email       String?
  phone       String?
  companyName String?
  jobTitle    String?
  source      String?
  status      LeadStatus @default(NEW)
  score       Int        @default(0)
  notes       String?
  archived    Boolean    @default(false)
  ownerId     String?
  owner       User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?      @relation("LeadCreator", fields: [createdById], references: [id])

  convertedAt            DateTime?
  convertedAccountId     String?
  convertedContactId     String?
  convertedOpportunityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  notesList  Note[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, ownerId])
  @@index([tenantId, createdById])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Saved Views
// ---------------------------------------------------------------------------

model SavedView {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  objectType String
  name       String
  filters    Json     @default("{}")
  sortBy     String?
  sortDir    String?
  columns    Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, objectType, ownerId])
  @@map("saved_views")
}

// ---------------------------------------------------------------------------
// Pipelines & Stages
// ---------------------------------------------------------------------------

enum PipelineType {
  OPPORTUNITY
}

model Pipeline {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  name      String
  type      PipelineType
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([tenantId, type])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])
  name        String
  order       Int
  probability Int      @default(0)
  isClosed    Boolean  @default(false)
  isWon       Boolean  @default(false)

  opportunities Opportunity[]
  approvalsFrom StageApproval[] @relation("ApprovalFromStage")
  approvalsTo   StageApproval[] @relation("ApprovalToStage")

  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ---------------------------------------------------------------------------
// Opportunities
// ---------------------------------------------------------------------------

enum OpportunityType {
  NEW_BUSINESS
  EXPANSION
  RENEWAL
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED_WON
  CLOSED_LOST
}

model Opportunity {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  name              String
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id])
  contactId         String?
  contact           Contact?         @relation("OpportunityPrimaryContact", fields: [contactId], references: [id])
  amount            Decimal          @db.Decimal(16, 2)
  expectedDealValue Decimal?         @db.Decimal(16, 2)
  actualDealValue   Decimal?         @db.Decimal(16, 2)
  bottomLineCost    Decimal?         @db.Decimal(16, 2)
  pipelineId        String
  pipeline          Pipeline         @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             PipelineStage    @relation(fields: [stageId], references: [id])
  probability       Int              @default(0)
  expectedCloseDate DateTime?
  ownerId           String
  owner             User             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdById       String?
  createdBy         User?            @relation("OpportunityCreator", fields: [createdById], references: [id])
  opportunityType   OpportunityType  @default(NEW_BUSINESS)
  dealType          String?
  forecastCategory  ForecastCategory @default(PIPELINE)
  actualCloseDate   DateTime?
  wonDate           DateTime?
  lostReason        String?
  leadSource        String?
  description       String?
  loeValue          String?
  loeUnit           String?          @default("Hours")
  poNumber          String?
  poValue           Decimal?         @db.Decimal(16, 2)
  properties        Json             @default("{}")
  archived          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  contacts       OpportunityContact[]
  stageHistory   OpportunityStageHistory[]
  activities     Activity[]
  notes          Note[]
  lineItems      LineItem[]
  quotes         Quote[]
  stageApprovals StageApproval[]
  attachments    OpportunityAttachment[]

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([tenantId, contactId])
  @@index([tenantId, stageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, createdById])
  @@map("opportunities")
}

model OpportunityContact {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])
  role          String?

  @@id([opportunityId, contactId])
  @@map("opportunity_contacts")
}

model OpportunityStageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  fromStageId   String?
  toStageId     String
  changedById   String
  changedAt     DateTime    @default(now())

  @@index([opportunityId])
  @@map("opportunity_stage_history")
}

// ---------------------------------------------------------------------------
// Products & Line Items
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("services")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  name        String
  sku         String?
  category    String?
  description String?
  unitPrice   Decimal  @db.Decimal(16, 2)
  currency    String   @default("USD")
  active      Boolean  @default(true)
  ownerId     String?
  owner       User?    @relation("ProductOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?    @relation("ProductCreator", fields: [createdById], references: [id])
  properties  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems LineItem[]

  @@index([tenantId])
  @@index([tenantId, serviceId])
  @@index([tenantId, sku])
  @@index([tenantId, createdById])
  @@map("products")
}

model LineItem {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  quantity      Decimal      @db.Decimal(12, 2)
  unitPrice     Decimal      @db.Decimal(16, 2)
  discountPct   Decimal      @default(0) @db.Decimal(5, 2)
  taxPct        Decimal      @default(0) @db.Decimal(5, 2)
  total         Decimal      @db.Decimal(16, 2)
  createdAt     DateTime     @default(now())

  @@index([opportunityId])
  @@index([quoteId])
  @@map("line_items")
}

// ---------------------------------------------------------------------------
// Quotes
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  quoteNumber    String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  accountId      String
  account        Account     @relation(fields: [accountId], references: [id])
  quoteDate      DateTime    @default(now())
  expirationDate DateTime?
  discountPct    Decimal     @default(0) @db.Decimal(5, 2)
  taxPct         Decimal     @default(0) @db.Decimal(5, 2)
  amount         Decimal     @db.Decimal(16, 2)
  currency       String      @default("USD")
  status         QuoteStatus @default(DRAFT)
  ownerId        String
  owner          User        @relation("QuoteOwner", fields: [ownerId], references: [id])
  createdById    String?
  createdBy      User?       @relation("QuoteCreator", fields: [createdById], references: [id])
  pdfUrl         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lineItems LineItem[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, createdById])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Activities & Notes (shared timeline)
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  FOLLOW_UP
  DEMO
  PROPOSAL
  OTHER
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AssociatedObjectType {
  ACCOUNT
  CONTACT
  OPPORTUNITY
  QUOTE
  LEAD
}

model Activity {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  type          ActivityType
  subject       String
  body          String?
  ownerId       String
  owner         User                 @relation("ActivityOwner", fields: [ownerId], references: [id])
  createdById   String?
  createdBy     User?                @relation("ActivityCreator", fields: [createdById], references: [id])
  dueDate       DateTime?
  completedDate DateTime?
  status        ActivityStatus       @default(PENDING)
  objectType    AssociatedObjectType
  accountId     String?
  account       Account?             @relation(fields: [accountId], references: [id])
  contactId     String?
  contact       Contact?             @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity?         @relation(fields: [opportunityId], references: [id])
  leadId        String?
  lead          Lead?                @relation(fields: [leadId], references: [id])
  metadata      Json                 @default("{}")
  createdAt     DateTime             @default(now())

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([tenantId, contactId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, leadId])
  @@index([tenantId, createdById])
  @@map("activities")
}

model Note {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  body          String
  authorId      String
  author        User         @relation("NoteAuthor", fields: [authorId], references: [id])
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Sequences (Phase 4)
// ---------------------------------------------------------------------------

enum SequenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DRAFT
}

model Sequence {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  ownerId     String
  owner       User           @relation("SequenceOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?          @relation("SequenceCreator", fields: [createdById], references: [id])
  status      SequenceStatus @default(DRAFT)
  createdAt   DateTime       @default(now())

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@index([tenantId, createdById])
  @@map("sequences")
}

enum SequenceStepType {
  EMAIL
  WAIT
  TASK
  CALL_REMINDER
}

model SequenceStep {
  id         String           @id @default(uuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id])
  order      Int
  type       SequenceStepType
  config     Json             @default("{}")

  @@index([sequenceId])
  @@map("sequence_steps")
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLIED
  UNENROLLED
}

model SequenceEnrollment {
  id             String           @id @default(uuid())
  sequenceId     String
  sequence       Sequence         @relation(fields: [sequenceId], references: [id])
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id])
  status         EnrollmentStatus @default(ACTIVE)
  currentStepIdx Int              @default(0)
  enrolledAt     DateTime         @default(now())
  lastActionAt   DateTime?
  nextActionAt   DateTime?

  @@index([sequenceId])
  @@index([contactId])
  @@map("sequence_enrollments")
}

// ---------------------------------------------------------------------------
// Associations (generic relationship model)
// ---------------------------------------------------------------------------

model Association {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  fromObjectType   String
  fromRecordId     String
  toObjectType     String
  toRecordId       String
  associationLabel String?
  createdAt        DateTime @default(now())

  @@index([tenantId, fromObjectType, fromRecordId])
  @@index([tenantId, toObjectType, toRecordId])
  @@map("associations")
}

// ---------------------------------------------------------------------------
// Custom Properties
// ---------------------------------------------------------------------------

enum PropertyType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  CURRENCY
  DROPDOWN
  MULTI_SELECT
  URL
  EMAIL
}

model PropertyDefinition {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  objectType   String
  name         String
  label        String
  type         PropertyType
  required     Boolean      @default(false)
  defaultValue String?
  enumOptions  Json?
  createdAt    DateTime     @default(now())

  @@unique([tenantId, objectType, name])
  @@map("property_definitions")
}

// ---------------------------------------------------------------------------
// Forecasting
// ---------------------------------------------------------------------------

model ForecastTarget {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  ownerId      String?
  period       String
  targetAmount Decimal  @db.Decimal(16, 2)
  createdAt    DateTime @default(now())

  @@unique([tenantId, ownerId, period])
  @@map("forecast_targets")
}

// ---------------------------------------------------------------------------
// Audit Log & Notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  objectType String
  recordId   String
  action     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, objectType, recordId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, userId, read])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Manager Stage Change Approvals
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  DISAPPROVED
  CANCELLED
}

model StageApproval {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  opportunityId    String
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approverId       String?
  approver         User?          @relation("ApprovalApprover", fields: [approverId], references: [id])
  reviewedById     String?
  reviewedBy       User?          @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])
  fromStageId      String
  fromStage        PipelineStage  @relation("ApprovalFromStage", fields: [fromStageId], references: [id])
  toStageId        String
  toStage          PipelineStage  @relation("ApprovalToStage", fields: [toStageId], references: [id])
  status           ApprovalStatus @default(PENDING)
  comments         String?
  requesterComment String?
  approverComment  String?
  loeValue         String?
  loeUnit          String?        @default("Hours")
  poNumber         String?
  poValue          Decimal?       @db.Decimal(16, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reviewedAt       DateTime?

  attachments      OpportunityAttachment[]

  @@index([tenantId, opportunityId])
  @@index([tenantId, requestedById])
  @@index([tenantId, approverId])
  @@index([tenantId, reviewedById])
  @@index([tenantId, status])
  @@map("stage_approvals")
}

// ---------------------------------------------------------------------------
// Sticky Notes (Global / Dashboard Personal Notes)
// ---------------------------------------------------------------------------

model StickyNote {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  user        User     @relation("UserStickyNotes", fields: [userId], references: [id])
  title       String?
  content     String   @default("")
  color       String?  @default("yellow")
  isPinned    Boolean  @default(false)
  isMinimized Boolean  @default(false)
  positionX   Int?     @default(0)
  positionY   Int?     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, userId])
  @@map("sticky_notes")
}

// ---------------------------------------------------------------------------
// Opportunity Attachments (Object-Storage Ready Metadata)
// ---------------------------------------------------------------------------

model OpportunityAttachment {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  opportunityId    String
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stageApprovalId  String?
  stageApproval    StageApproval? @relation(fields: [stageApprovalId], references: [id], onDelete: SetNull)
  originalFilename String
  mimeType         String
  size             Int
  storageKey       String?
  uploadedById     String
  uploadedBy       User           @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt        DateTime       @default(now())

  @@index([tenantId, opportunityId])
  @@index([tenantId, stageApprovalId])
  @@map("opportunity_attachments")
}



