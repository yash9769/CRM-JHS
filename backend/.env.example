DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_dev?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# TOTP (two-factor login) — see src/lib/totp.ts
# Encrypts stored TOTP secrets at rest. Falls back to a key derived from JWT_SECRET
# if unset, but set this explicitly in production.
TOTP_ENC_KEY="change-me-to-a-long-random-string"
# Signs the short-lived intermediate tokens used between "password verified" and
# "TOTP setup/challenge complete". Falls back to a value derived from JWT_SECRET
# if unset, but set this explicitly in production (must differ from JWT_SECRET).
TOTP_FLOW_SECRET="change-me-to-a-different-long-random-string"
# Issuer name shown in the user's authenticator app.
TOTP_ISSUER="Envista CRM"

# SMTP — used by scripts/createUser.ts to email new users their credentials.
# If SMTP_HOST is unset, the script prints the email to the console instead of
# sending it, so it still works without SMTP configured (e.g. in local dev).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Envista CRM <no-reply@envistacyberdefence.com>"

# Base URL the "sign in" link in the welcome email points to.
APP_LOGIN_URL="http://localhost:5173/login"
